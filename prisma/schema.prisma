generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Tenancy & Auth ----------

model Company {
  id             String   @id @default(cuid())
  name           String
  industry       String?
  defaultTaxRate Float    @default(0)
  createdAt      DateTime @default(now())

  // Custom logo shown on invoices, payslips, business reports, and
  // customer-facing emails in place of the default AIBOS wordmark. PNG/JPEG
  // only (pdf-lib's embedPng/embedJpg support nothing else).
  logoData     Bytes?
  logoMimeType String?

  users               User[]
  customers           Customer[]
  products            Product[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  orders              Order[]
  returns             ReturnAuthorization[]
  returnPolicy        ReturnPolicy?
  bomLines            BomLine[]
  workOrders          WorkOrder[]
  mrpSettings         MrpSettings?
  ediSettings         EdiSettings?
  ediPartners         EdiPartner[]
  ediDocuments        EdiDocument[]
  costCenters         CostCenter[]
  internalOrders      InternalOrder[]
  coAllocations       CoAllocation[]
  coPostings          CoPosting[]
  controllingSettings ControllingSettings?
  stockLots           StockLot[]
  lotMovements        LotMovement[]
  inventorySettings   InventorySettings?
  invoices            Invoice[]
  transactions        Transaction[]
  employees           Employee[]
  payrollRuns         PayrollRun[]
  projects            Project[]
  tickets             Ticket[]
  chatMessages        AiChatMessage[]
  aiActions           AiAction[]
  auditLogs           AuditLog[]
  documents           Document[]
  automationSettings  AutomationSettings?
  googleIntegration   GoogleIntegration?
  campaigns           Campaign[]
  calendarEvents      CalendarEvent[]
  subscription        Subscription?
  teamInvites         TeamInvite[]
  branches            Branch[]
  branchStock         BranchStock[]
}

enum UserRole {
  OWNER
  ADMIN
  EMPLOYEE
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                UserRole  @default(OWNER)
  createdAt           DateTime  @default(now())
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Branch access: null means every branch; set, the user only sees and
  // creates records for this one branch. Owners are never restricted.
  branchId String?
  branch   Branch? @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)

  chatMessages        AiChatMessage[]
  requestedAiActions  AiAction[]           @relation("AiActionRequestedBy")
  decidedAiActions    AiAction[]           @relation("AiActionDecidedBy")
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  taskComments        TaskComment[]
  ticketMessages      TicketMessage[]
  sentInvites         TeamInvite[]

  @@index([companyId])
  @@index([branchId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  email      String
  role       UserRole  @default(EMPLOYEE)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedBy       User   @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
}

// A physical location of the business: a shop, office, warehouse or site.
// Every company has at least one (the Main branch, created at signup or by
// the migration for existing companies). Branches are deactivated rather
// than deleted once they have records.
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String
  address   String?
  active    Boolean  @default(true)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users          User[]          @relation("UserBranch")
  orders         Order[]         @relation("OrderBranch")
  invoices       Invoice[]       @relation("InvoiceBranch")
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderBranch")
  employees      Employee[]      @relation("EmployeeBranch")
  costCenters    CostCenter[]    @relation("CostCenterBranch")
  stock          BranchStock[]
  lots           StockLot[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Stock of one product at one branch. A branch only "stocks" a product
// once it has a row here; low stock alerts only look at existing rows.
model BranchStock {
  id           String @id @default(cuid())
  quantity     Int    @default(0)
  // Null means use the product's own reorder level.
  reorderLevel Int?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([companyId])
  @@index([productId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ---------- CRM ----------

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id                  String         @id @default(cuid())
  name                String
  email               String?
  phone               String?
  company             String?
  status              CustomerStatus @default(LEAD)
  notes               String?
  creditLimit         Float?
  creditWarningSentAt DateTime?
  createdAt           DateTime       @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  contacts    Contact[]
  orders      Order[]
  invoices    Invoice[]
  tickets     Ticket[]
  projects    Project[]
  ediPartners EdiPartner[]

  @@index([companyId])
  @@index([campaignId])
}

model Contact {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  role  String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ---------- Inventory ----------

model Product {
  id           String   @id @default(cuid())
  sku          String
  name         String
  description  String?
  cost         Float    @default(0)
  unitPrice    Float
  stockQty     Int      @default(0)
  reorderLevel Int      @default(5)
  createdAt    DateTime @default(now())

  // MRP planning inputs. Lead time is how long it takes to buy (or make)
  // one batch; lot size rounds planned quantities up to whole batches.
  leadTimeDays        Int       @default(0)
  lotSize             Int       @default(1)
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  // Lot and serial tracking. Lot and serial products keep stockQty equal
  // to the sum of their lots' quantities.
  trackingMode TrackingMode @default(NONE)
  tracksExpiry Boolean      @default(false)
  lots         StockLot[]

  // stockQty above is the company total: always the sum of these rows.
  branchStock BranchStock[]

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderItems         OrderItem[]
  invoiceLineItems   InvoiceLineItem[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  bomComponents      BomLine[]           @relation("BomParent")
  usedInBoms         BomLine[]           @relation("BomComponent")
  workOrders         WorkOrder[]

  @@unique([companyId, sku])
  @@index([companyId])
}

// ---------- Procurement ----------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchaseOrders    PurchaseOrder[]
  preferredProducts Product[]
  ediPartners       EdiPartner[]

  @@index([companyId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Float               @default(0)
  createdAt    DateTime            @default(now())
  expectedDate DateTime?
  receivedAt   DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("PurchaseOrderBranch", fields: [branchId], references: [id], onDelete: SetNull)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  items PurchaseOrderItem[]

  @@index([companyId])
  @@index([supplierId])
  @@index([branchId])
}

model PurchaseOrderItem {
  id       String @id @default(cuid())
  quantity Int
  unitCost Float

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

// ---------- Sales ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  status           OrderStatus @default(PENDING)
  totalAmount      Float       @default(0)
  createdAt        DateTime    @default(now())
  // When goods left the business; the return window counts from here.
  fulfilledAt      DateTime?
  // The customer's own PO number, e.g. from an inbound EDI 850.
  customerPoNumber String?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("OrderBranch", fields: [branchId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items   OrderItem[]
  invoice Invoice?
  returns ReturnAuthorization[]

  @@index([companyId])
  @@index([customerId])
  @@index([branchId])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Int
  unitPrice Float

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  returnItems ReturnItem[]

  @@index([orderId])
}

// ---------- Returns (RMA) ----------

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

// Only resellable goods go back into stock when a return is received;
// damaged goods are refunded but written off.
enum ReturnCondition {
  RESELLABLE
  DAMAGED
}

model ReturnAuthorization {
  id                   String       @id @default(cuid())
  rmaNumber            String
  status               ReturnStatus @default(REQUESTED)
  reason               String
  notes                String?
  // Copied from the policy when the return is opened, so later policy
  // edits never change the refund on a return already in progress.
  restockingFeePercent Float        @default(0)
  refundAmount         Float        @default(0)
  createdAt            DateTime     @default(now())
  receivedAt           DateTime?
  refundedAt           DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  items ReturnItem[]

  @@unique([companyId, rmaNumber])
  @@index([companyId])
  @@index([orderId])
}

// Per company return rules, so a clothing store, an electronics reseller
// and a wholesaler can each run returns their own way. A company with no
// row uses the defaults in lib/returns-policy.ts.
model ReturnPolicy {
  id                   String  @id @default(cuid())
  enabled              Boolean @default(true)
  windowDays           Int     @default(30)
  requireApproval      Boolean @default(true)
  restockingFeePercent Float   @default(0)
  restockDamaged       Boolean @default(false)
  // One reason per line; shown as the reason choices on a new return.
  reasons              String

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ReturnItem {
  id        String          @id @default(cuid())
  quantity  Int
  unitPrice Float
  condition ReturnCondition @default(RESELLABLE)

  returnId String
  rma      ReturnAuthorization @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([orderItemId])
}

// ---------- Invoicing ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  taxRate            Float         @default(0)
  totalAmount        Float         @default(0)
  createdAt          DateTime      @default(now())
  lastReminderSentAt DateTime?
  sentAt             DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("InvoiceBranch", fields: [branchId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  lineItems    InvoiceLineItem[]
  transactions Transaction[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([branchId])
}

model InvoiceLineItem {
  id          String @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// ---------- Accounting ----------

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Float
  description String?
  date        DateTime        @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Controlling: which cost center or internal order carries this cost.
  costCenterId    String?
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  internalOrderId String?
  internalOrder   InternalOrder? @relation(fields: [internalOrderId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([costCenterId])
  @@index([internalOrderId])
}

// ---------- HR & Payroll ----------

enum EmployeeStatus {
  ACTIVE
  TERMINATED
}

model Employee {
  id         String         @id @default(cuid())
  name       String
  email      String?
  position   String?
  department String?
  salary     Float          @default(0)
  hireDate   DateTime       @default(now())
  status     EmployeeStatus @default(ACTIVE)

  // Paid payroll for this employee counts as cost on this cost center.
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("EmployeeBranch", fields: [branchId], references: [id], onDelete: SetNull)

  payrollItems PayrollItem[]
  tasks        Task[]
  tickets      Ticket[]

  @@index([companyId])
  @@index([branchId])
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

model PayrollRun {
  id          String           @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(DRAFT)
  totalAmount Float            @default(0)
  processedAt DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items PayrollItem[]

  @@index([companyId])
}

model PayrollItem {
  id         String @id @default(cuid())
  grossPay   Float
  deductions Float  @default(0)
  netPay     Float

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([payrollRunId])
}

// ---------- Project Management ----------

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  tasks        Task[]
  transactions Transaction[]

  @@index([companyId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  comments TaskComment[]

  @@index([projectId])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ---------- Customer Support ----------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model Ticket {
  id          String         @id @default(cuid())
  subject     String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  messages TicketMessage[]

  @@index([companyId])
}

enum TicketMessageAuthor {
  STAFF
  CUSTOMER
}

model TicketMessage {
  id         String              @id @default(cuid())
  content    String
  authorType TicketMessageAuthor
  createdAt  DateTime            @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ---------- AI Assistant ----------

enum ChatRole {
  USER
  ASSISTANT
}

model AiChatMessage {
  id        String   @id @default(cuid())
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiActions AiAction[]

  @@index([companyId])
}

// ---------- AI Actions (proposals + audit log) ----------

enum AiActionType {
  CREATE_TASK
  UPDATE_TICKET_STATUS
  UPDATE_TICKET_PRIORITY
  UPDATE_CUSTOMER_STATUS
  CREATE_INVOICE
  SEND_OVERDUE_REMINDER
}

enum AiActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AiAction {
  id         String         @id @default(cuid())
  type       AiActionType
  status     AiActionStatus @default(PENDING)
  summary    String
  input      String
  result     String?
  error      String?
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?
  executedAt DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User   @relation("AiActionRequestedBy", fields: [requestedByUserId], references: [id])

  decidedByUserId String?
  decidedBy       User?   @relation("AiActionDecidedBy", fields: [decidedByUserId], references: [id])

  chatMessageId String?
  chatMessage   AiChatMessage? @relation(fields: [chatMessageId], references: [id])

  @@index([companyId])
  @@index([chatMessageId])
}

// ---------- Documents ----------

enum DocumentEntityType {
  CUSTOMER
  INVOICE
  TICKET
  PROJECT
  CAMPAIGN
  EMPLOYEE
}

model Document {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType DocumentEntityType
  entityId   String

  @@index([companyId, entityType, entityId])
}

// ---------- Automation ----------

enum ReportFrequency {
  OFF
  WEEKLY
  MONTHLY
  QUARTERLY
}

model AutomationSettings {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  overdueInvoiceReminders Boolean @default(false)
  lowStockReorder         Boolean @default(false)
  staleTicketEscalation   Boolean @default(false)
  staleLeadCleanup        Boolean @default(false)
  creditLimitWarnings     Boolean @default(false)

  // A single outgoing webhook URL (Slack Incoming Webhook, Zapier "Catch
  // Hook", or any custom JSON endpoint). Fires on the five automation
  // events above (only when each is itself enabled) plus every new support
  // ticket.
  webhookUrl String?

  // Emails a PDF business report (KPIs + charts) to the company on the
  // chosen cadence. lastReportSentAt drives the due check the same way
  // Invoice.lastReminderSentAt does for overdue reminders.
  reportFrequency  ReportFrequency @default(OFF)
  lastReportSentAt DateTime?

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Integrations ----------

model GoogleIntegration {
  id           String   @id @default(cuid())
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Automation locking ----------

// Singleton row (a fixed id, e.g. "automations") used as a lease lock so
// only one process runs a given background job at a time, safe under
// Prisma's connection pooling (unlike a Postgres advisory lock, which is
// tied to a specific connection the pool doesn't guarantee stays fixed
// across an acquire/release pair).
model RunLock {
  id          String    @id
  lockedUntil DateTime?
}

// ---------- Marketing ----------

enum CampaignChannel {
  EMAIL
  SOCIAL
  ADS
  EVENT
  REFERRAL
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id        String          @id @default(cuid())
  name      String
  channel   CampaignChannel @default(OTHER)
  status    CampaignStatus  @default(DRAFT)
  budget    Float           @default(0)
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime        @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  leads Customer[]

  @@index([companyId])
}

// ---------- Calendar ----------

enum CalendarEventType {
  MEETING
  REMINDER
  OTHER
}

model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        CalendarEventType @default(MEETING)
  startAt     DateTime
  endAt       DateTime?
  createdAt   DateTime          @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startAt])
}

// ---------- Billing ----------

// One flat-rate subscription per company. Single plan for now (see
// price_1TrKojRxRmfasatIyltWTQit in Stripe) — a Plan model can be added
// later if multiple tiers are introduced.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Platform settings ----------

// Singleton row (fixed id "platform") for app-wide config that isn't tied to
// any one tenant company — e.g. the email-sending credential shared by every
// company's transactional email. Only settable by the platform operator
// (gated by PLATFORM_ADMIN_EMAIL, not by any company's OWNER role), since a
// regular tenant should never be able to see or overwrite the credential
// every other tenant's email depends on.
model PlatformSettings {
  id              String   @id
  resendApiKey    String?
  resendFromEmail String?
  groqApiKey      String?
  openaiApiKey    String?
  updatedAt       DateTime @updatedAt
}

// ---------- Manufacturing & MRP ----------

// One line of a bill of materials: making one unit of `parent` uses
// `quantity` units of `component`. A product with BOM lines is made in
// house; one without is bought.
model BomLine {
  id       String @id @default(cuid())
  quantity Float

  parentId String
  parent   Product @relation("BomParent", fields: [parentId], references: [id], onDelete: Cascade)

  componentId String
  component   Product @relation("BomComponent", fields: [componentId], references: [id])

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([parentId, componentId])
  @@index([companyId])
  @@index([componentId])
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id          String          @id @default(cuid())
  woNumber    String
  status      WorkOrderStatus @default(PLANNED)
  quantity    Int
  notes       String?
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, woNumber])
  @@index([companyId])
  @@index([productId])
}

// Per company MRP rules. A company with no row uses the defaults in
// lib/mrp-settings-presets.ts.
model MrpSettings {
  id                   String  @id @default(cuid())
  enabled              Boolean @default(true)
  // Count PENDING sales orders as demand, not just CONFIRMED ones.
  includePendingOrders Boolean @default(false)
  // Treat each product's reorder level as safety stock to keep on hand.
  useSafetyStock       Boolean @default(true)
  // Allow a work order to complete even when components are short
  // (stock can go negative until the paperwork catches up).
  allowNegativeStock   Boolean @default(false)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- EDI (ANSI X12) ----------

// This company's own EDI identity and file format. A company with no row
// has EDI switched off until it's set up.
model EdiSettings {
  id                  String  @id @default(cuid())
  enabled             Boolean @default(true)
  isaQualifier        String  @default("ZZ")
  isaId               String
  gsId                String
  // "004010" or "005010".
  version             String  @default("004010")
  // T = test, P = production (ISA15).
  usageIndicator      String  @default("T")
  elementSeparator    String  @default("*")
  subElementSeparator String  @default(">")
  segmentTerminator   String  @default("~")
  nextControlNumber   Int     @default(1)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// A customer or supplier this company exchanges EDI files with.
model EdiPartner {
  id           String   @id @default(cuid())
  name         String
  isaQualifier String   @default("ZZ")
  isaId        String
  gsId         String
  enabled      Boolean  @default(true)
  // Which documents are exchanged with this partner.
  receive850   Boolean  @default(true)
  send810      Boolean  @default(true)
  send856      Boolean  @default(true)
  send850      Boolean  @default(true)
  // Inbound orders: take the partner's prices, or use our own list price.
  useEdiPrices Boolean  @default(true)
  createdAt    DateTime @default(now())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  documents EdiDocument[]

  @@unique([companyId, isaQualifier, isaId])
  @@index([companyId])
}

enum EdiDirection {
  INBOUND
  OUTBOUND
}

enum EdiStatus {
  GENERATED
  PROCESSED
  REJECTED
}

// Every X12 file generated or received, kept as sent so it can be
// downloaded again or audited.
model EdiDocument {
  id            String       @id @default(cuid())
  direction     EdiDirection
  docType       String
  status        EdiStatus
  controlNumber Int
  reference     String?
  error         String?
  content       String
  createdAt     DateTime     @default(now())

  partnerId String?
  partner   EdiPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // What the document is about, when it maps to a record here.
  orderId         String?
  purchaseOrderId String?
  invoiceId       String?
  // An inbound document's 997 acknowledgment, and vice versa.
  acknowledgesId  String?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([partnerId])
  @@index([orderId])
}

// ---------- Controlling (CO) ----------

model CostCenter {
  id          String   @id @default(cuid())
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Optional: ties this cost center to a branch, for profit per branch.
  branchId String?
  branch   Branch? @relation("CostCenterBranch", fields: [branchId], references: [id], onDelete: SetNull)

  transactions     Transaction[]
  employees        Employee[]
  budgets          CostBudget[]
  postings         CoPosting[]
  settlingOrders   InternalOrder[]        @relation("SettlementReceiver")
  allocationsSent  CoAllocation[]         @relation("AllocationSender")
  allocationShares CoAllocationReceiver[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
}

// Planned cost for one cost center in one calendar month.
model CostBudget {
  id     String @id @default(cuid())
  year   Int
  month  Int
  amount Float

  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([costCenterId, year, month])
}

enum InternalOrderStatus {
  OPEN
  CLOSED
  SETTLED
}

// A temporary cost collector (a trade fair, a campaign, a repair) with its
// own budget, settled onto a cost center when it's done.
model InternalOrder {
  id          String              @id @default(cuid())
  orderNumber String
  name        String
  description String?
  budget      Float               @default(0)
  status      InternalOrderStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  closedAt    DateTime?
  settledAt   DateTime?

  settleToId String?
  settleTo   CostCenter? @relation("SettlementReceiver", fields: [settleToId], references: [id], onDelete: SetNull)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  postings     CoPosting[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
}

// A cost allocation cycle: shares one sender cost center's cost out to
// receivers by fixed percentages.
model CoAllocation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  senderId String
  sender   CostCenter @relation("AllocationSender", fields: [senderId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  receivers CoAllocationReceiver[]
  runs      CoAllocationRun[]

  @@index([companyId])
}

model CoAllocationReceiver {
  id      String @id @default(cuid())
  percent Float

  allocationId String
  allocation   CoAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([allocationId, costCenterId])
}

model CoAllocationRun {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  amount    Float
  createdAt DateTime @default(now())

  allocationId String
  allocation   CoAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  postings CoPosting[]

  @@unique([allocationId, year, month])
}

enum CoPostingKind {
  ALLOCATION
  SETTLEMENT
}

// Secondary cost postings that exist only inside Controlling: they move
// cost between cost centers and orders without touching the books.
// Positive amounts add cost, negative amounts credit it away.
model CoPosting {
  id        String        @id @default(cuid())
  kind      CoPostingKind
  date      DateTime
  amount    Float
  reference String
  createdAt DateTime      @default(now())

  costCenterId    String?
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  internalOrderId String?
  internalOrder   InternalOrder?   @relation(fields: [internalOrderId], references: [id], onDelete: Cascade)
  runId           String?
  run             CoAllocationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([costCenterId])
  @@index([internalOrderId])
}

enum OverBudgetAction {
  NONE
  WARN
  BLOCK
}

// Per company Controlling rules. A company with no row uses the defaults
// in lib/controlling-presets.ts.
model ControllingSettings {
  id                   String           @id @default(cuid())
  enabled              Boolean          @default(true)
  // 1 = January. A July to June business would use 7.
  fiscalYearStartMonth Int              @default(1)
  overBudgetAction     OverBudgetAction @default(WARN)
  // How far over budget is still allowed before the action kicks in.
  tolerancePercent     Float            @default(0)
  includePayroll       Boolean          @default(true)
  requireCostCenter    Boolean          @default(false)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Lot & serial tracking ----------

enum TrackingMode {
  NONE
  LOT
  SERIAL
}

enum PickingRule {
  FIFO
  FEFO
}

// One lot (or, for serial products, one unit) of a product on hand.
model StockLot {
  id         String    @id @default(cuid())
  lotNumber  String
  quantity   Int
  expiresAt  DateTime?
  receivedAt DateTime  @default(now())
  // Where it came from: PO, WO, OPENING or RETURN.
  source     String

  purchaseOrderId String?
  workOrderId     String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // The branch the lot sits at. The same lot number can sit at two
  // branches once part of it is moved.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  movements LotMovement[]

  @@unique([productId, branchId, lotNumber])
  @@index([branchId])
  @@index([companyId])
  @@index([companyId, expiresAt])
}

enum LotMovementKind {
  RECEIPT
  SALE
  CONSUMPTION
  PRODUCTION
  RETURN
  OPENING
}

// Every change to a lot's quantity, so any lot or serial can be traced
// forward to the customers who got it and back to where it came from.
model LotMovement {
  id        String          @id @default(cuid())
  kind      LotMovementKind
  // Positive adds to the lot, negative takes from it.
  quantity  Int
  createdAt DateTime        @default(now())

  lotId String
  lot   StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  orderId         String?
  purchaseOrderId String?
  workOrderId     String?
  returnId        String?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([companyId])
  @@index([orderId])
}

// Per company picking and expiry rules. A company with no row uses the
// defaults in lib/inventory-settings.ts.
model InventorySettings {
  id                String      @id @default(cuid())
  pickingRule       PickingRule @default(FIFO)
  blockExpired      Boolean     @default(true)
  expiryWarningDays Int         @default(30)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
