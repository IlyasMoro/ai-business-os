generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Tenancy & Auth ----------

model Company {
  id               String   @id @default(cuid())
  name             String
  industry         String?
  defaultTaxRate   Float    @default(0)
  createdAt        DateTime @default(now())
  // Last sales order number handed out (SO-0001 = 1); bumped atomically
  // by lib/order-number.ts so two orders at once never share a number.
  orderSeq         Int      @default(0)
  // Last invoice number handed out (INV-0001 = 1), same idea as orderSeq;
  // see lib/invoice-number.ts.
  invoiceSeq       Int      @default(0)
  // Last purchase order number handed out (PO-0001 = 1).
  purchaseOrderSeq Int      @default(0)
  // Last credit note number handed out (CN-0001 = 1).
  creditNoteSeq    Int      @default(0)

  // Custom logo shown on invoices, payslips, business reports, and
  // customer-facing emails in place of the default AIBOS wordmark. PNG/JPEG
  // only (pdf-lib's embedPng/embedJpg support nothing else).
  logoData     Bytes?
  logoMimeType String?

  users               User[]
  customers           Customer[]
  products            Product[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  orders              Order[]
  returns             ReturnAuthorization[]
  returnPolicy        ReturnPolicy?
  bomLines            BomLine[]
  workOrders          WorkOrder[]
  mrpSettings         MrpSettings?
  ediSettings         EdiSettings?
  ediPartners         EdiPartner[]
  ediDocuments        EdiDocument[]
  costCenters         CostCenter[]
  internalOrders      InternalOrder[]
  coAllocations       CoAllocation[]
  coPostings          CoPosting[]
  controllingSettings ControllingSettings?
  stockLots           StockLot[]
  lotMovements        LotMovement[]
  stockMovements      StockMovement[]
  inventorySettings   InventorySettings?
  invoices            Invoice[]
  transactions        Transaction[]
  employees           Employee[]
  payrollRuns         PayrollRun[]
  projects            Project[]
  tickets             Ticket[]
  chatMessages        AiChatMessage[]
  aiActions           AiAction[]
  auditLogs           AuditLog[]
  documents           Document[]
  automationSettings  AutomationSettings?
  googleIntegration   GoogleIntegration?
  campaigns           Campaign[]
  calendarEvents      CalendarEvent[]
  subscription        Subscription?
  teamInvites         TeamInvite[]
  branches            Branch[]
  branchStock         BranchStock[]
  stockTransfers      StockTransfer[]
  aiUsage             AiUsage[]
  aiTopUps            AiTopUp[]
  deals               Deal[]
  crmActivities       CrmActivity[]
  followUps           FollowUp[]
  quotes              Quote[]
  customerTags        CustomerTag[]
  customFields        CustomField[]
  crmSettings         CrmSettings?
  duplicateDismissals DuplicateDismissal[]
  emailSequences      EmailSequence[]
  sequenceEnrollments SequenceEnrollment[]
  crmRules            CrmRule[]

  // The subscription plan (lib/plans.ts) whose limits apply: users,
  // branches, Growth/Scale modules and AI requests. Defaults to SCALE so
  // trials get everything and companies from before plans keep everything
  // until checkout records the plan they actually pay for.
  plan CompanyPlan @default(SCALE)

  // Bought AI requests (top-ups) not used yet. Spent only once the plan's
  // monthly requests run out, and they never expire.
  aiCredits Int @default(0)

  // An Enterprise plan the client built (lib/enterprise.ts), copied from the
  // Stripe subscription's quantities. Null users means none: a plain plan,
  // or Enterprise on its standard limits (trials, earlier Scale customers).
  customUsers      Int?
  customBranches   Int?
  customAiRequests Int?
  customEdi        Boolean @default(false)
}

enum CompanyPlan {
  SOLO
  STARTER
  GROWTH
  BUSINESS
  SCALE
}

// AI requests a company has used in one calendar month (UTC), for the
// plan's monthly allowance. A counter rather than counting chat messages,
// because people can clear their chat history.
model AiUsage {
  id       String @id @default(cuid())
  month    String // "2026-10"
  requests Int    @default(0)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month])
}

// One paid AI top-up. The unique Stripe Checkout session makes crediting
// safe to repeat: the return from Checkout and the webhook both try.
model AiTopUp {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  requests        Int
  amountCents     Int
  createdAt       DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  EMPLOYEE
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                UserRole  @default(OWNER)
  createdAt           DateTime  @default(now())
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Sign-ins issued before this are rejected (lib/dal.ts verifySession).
  // Set when the password changes, which signs out every other device.
  sessionsValidAfter  DateTime?
  // The day ("2026-10-05") the morning reminder summary was last emailed.
  digestSentOn        String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Branch access: null means every branch; set, the user only sees and
  // creates records for this one branch. Owners are never restricted.
  branchId String?
  branch   Branch? @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)

  chatMessages        AiChatMessage[]
  requestedAiActions  AiAction[]           @relation("AiActionRequestedBy")
  decidedAiActions    AiAction[]           @relation("AiActionDecidedBy")
  stockMovements      StockMovement[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  taskComments        TaskComment[]
  ticketMessages      TicketMessage[]
  sentInvites         TeamInvite[]
  ownedCustomers      Customer[]           @relation("CustomerOwner")
  ownedDeals          Deal[]               @relation("DealOwner")
  ownedQuotes         Quote[]              @relation("QuoteOwner")
  crmActivities       CrmActivity[]        @relation("CrmActivityAuthor")
  assignedFollowUps   FollowUp[]           @relation("FollowUpAssignee")
  createdFollowUps    FollowUp[]           @relation("FollowUpCreator")
  sequenceEnrollments SequenceEnrollment[] @relation("SequenceEnroller")

  @@index([companyId])
  @@index([branchId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  email      String
  role       UserRole  @default(EMPLOYEE)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedBy       User   @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
}

// A physical location of the business: a shop, office, warehouse or site.
// Every company has at least one (the Main branch, created at signup or by
// the migration for existing companies). Branches are deactivated rather
// than deleted once they have records.
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String
  address   String?
  active    Boolean  @default(true)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users          User[]          @relation("UserBranch")
  orders         Order[]         @relation("OrderBranch")
  quotes         Quote[]         @relation("QuoteBranch")
  invoices       Invoice[]       @relation("InvoiceBranch")
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderBranch")
  employees      Employee[]      @relation("EmployeeBranch")
  costCenters    CostCenter[]    @relation("CostCenterBranch")
  stock          BranchStock[]
  movements      StockMovement[]
  lots           StockLot[]
  transfersOut   StockTransfer[] @relation("TransferFrom")
  transactions   Transaction[]   @relation("TransactionBranch")
  transfersIn    StockTransfer[] @relation("TransferTo")

  @@unique([companyId, code])
  @@index([companyId])
}

// Stock of one product at one branch. A branch only "stocks" a product
// once it has a row here; low stock alerts only look at existing rows.
model BranchStock {
  id           String @id @default(cuid())
  quantity     Float  @default(0)
  // Null means use the product's own reorder level.
  reorderLevel Float?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([companyId])
  @@index([productId])
}

enum StockTransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

// Moves stock from one branch to another. Sending takes it out of the
// source branch (and out of specific lots); receiving puts it into the
// destination. In between it is in transit and counts at neither branch.
model StockTransfer {
  id             String              @id @default(cuid())
  transferNumber String
  status         StockTransferStatus @default(DRAFT)
  note           String?
  // Drafted by an automation: only an owner or admin may approve (send) it.
  autoCreated    Boolean             @default(false)
  createdAt      DateTime            @default(now())
  sentAt         DateTime?
  receivedAt     DateTime?

  fromBranchId String
  fromBranch   Branch @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranchId   String
  toBranch     Branch @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items StockTransferItem[]

  @@unique([companyId, transferNumber])
  @@index([companyId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model StockTransferItem {
  id       String @id @default(cuid())
  quantity Float

  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
  @@index([productId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ---------- CRM ----------

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id                  String         @id @default(cuid())
  name                String
  email               String?
  phone               String?
  company             String?
  status              CustomerStatus @default(LEAD)
  notes               String?
  creditLimit         Float?
  creditWarningSentAt DateTime?
  createdAt           DateTime       @default(now())
  // Where the lead came from, for filtering and reports.
  source              LeadSource?

  // The salesperson who looks after this account.
  ownerId String?
  owner   User?   @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Labels like "VIP" or "Wholesale", for filtering.
  tags         CustomerTag[]
  // Values for the company's own fields (CustomField), keyed by field id.
  customFields Json          @default("{}")
  // 0 to 100, how warm the customer is (lib/lead-score.ts). Kept on the row
  // so the list can sort by it; refreshed on changes and by the cron.
  leadScore    Int           @default(0)
  // Set when they unsubscribe from sequence emails.
  emailOptOut  Boolean       @default(false)

  deals               Deal[]
  crmActivities       CrmActivity[]
  followUps           FollowUp[]
  quotes              Quote[]
  sequenceEnrollments SequenceEnrollment[]

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  contacts    Contact[]
  orders      Order[]
  invoices    Invoice[]
  tickets     Ticket[]
  projects    Project[]
  ediPartners EdiPartner[]

  @@index([companyId])
  @@index([campaignId])
}

enum LeadSource {
  WEBSITE
  REFERRAL
  CAMPAIGN
  EVENT
  OUTREACH
  SOCIAL
  OTHER
}

// ---------- CRM pipeline ----------

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// A sales opportunity with one customer, moved across the pipeline board.
model Deal {
  id             String    @id @default(cuid())
  title          String
  value          Float     @default(0)
  stage          DealStage @default(NEW)
  // Chance of winning, 0 to 100; defaults by stage (lib/crm-pipeline.ts).
  probability    Int       @default(10)
  expectedClose  DateTime?
  lostReason     String?
  // Set when the deal is won or lost.
  closedAt       DateTime?
  // Order within its stage column on the board.
  position       Float     @default(0)
  // The expected close date an "overdue" reminder was made for, so a
  // deal gets one reminder per date it misses.
  closeNudgedFor DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  activities CrmActivity[]
  followUps  FollowUp[]
  quotes     Quote[]
  // What the customer is interested in; when set, the deal's value is their total.
  items      DealItem[]

  @@index([companyId, stage])
  @@index([customerId])
}

enum CrmActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  WHATSAPP
}

// Something that happened with a customer: a call, meeting, email or note.
model CrmActivity {
  id         String          @id @default(cuid())
  type       CrmActivityType @default(NOTE)
  body       String
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  // The Gmail message id for emails logged by the mailbox sync, so the
  // same email is never logged twice.
  externalId String?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation("CrmActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([companyId, externalId])
  @@index([customerId, occurredAt])
  @@index([dealId])
}

// A reminder to get back to a customer by a date, for one person.
model FollowUp {
  id        String    @id @default(cuid())
  title     String
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, doneAt, dueAt])
  @@index([customerId])
}

model Contact {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  role  String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ---------- Inventory ----------

model Product {
  id           String   @id @default(cuid())
  sku          String
  name         String
  description  String?
  cost         Float    @default(0)
  unitPrice    Float
  // How the product is counted. EACH stays whole numbers; KG and L are
  // sold by weight or volume, to three decimals (1.350 kg). Every quantity
  // column is a Float so weighed stock fits; see src/lib/quantity.ts.
  unit         UnitOfMeasure @default(EACH)
  stockQty     Float    @default(0)
  reorderLevel Float    @default(5)
  createdAt    DateTime @default(now())

  // MRP planning inputs. Lead time is how long it takes to buy (or make)
  // one batch; lot size rounds planned quantities up to whole batches.
  leadTimeDays        Int       @default(0)
  lotSize             Float     @default(1)
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  // Lot and serial tracking. Lot and serial products keep stockQty equal
  // to the sum of their lots' quantities.
  trackingMode TrackingMode @default(NONE)
  tracksExpiry Boolean      @default(false)
  lots         StockLot[]

  // stockQty above is the company total: always the sum of these rows.
  branchStock   BranchStock[]
  movements     StockMovement[]
  transferItems StockTransferItem[]

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderItems         OrderItem[]
  quoteItems         QuoteItem[]
  dealItems          DealItem[]
  invoiceLineItems   InvoiceLineItem[]
  purchaseOrderItems PurchaseOrderItem[]
  returnItems        ReturnItem[]
  bomComponents      BomLine[]           @relation("BomParent")
  usedInBoms         BomLine[]           @relation("BomComponent")
  workOrders         WorkOrder[]

  @@unique([companyId, sku])
  @@index([companyId])
}

// ---------- Procurement ----------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchaseOrders    PurchaseOrder[]
  preferredProducts Product[]
  ediPartners       EdiPartner[]

  @@index([companyId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  // PO-0001, per company (lib/po-rules.ts, takePurchaseOrderNumber).
  poNumber     String
  status       PurchaseOrderStatus @default(DRAFT)
  // Drafted by an automation: only an owner or admin may move it on from draft.
  autoCreated  Boolean             @default(false)
  totalAmount  Float               @default(0)
  createdAt    DateTime            @default(now())
  expectedDate DateTime?
  receivedAt   DateTime?
  // When it was last emailed to the supplier.
  sentAt       DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("PurchaseOrderBranch", fields: [branchId], references: [id], onDelete: SetNull)

  // Restrict: a supplier with purchase orders can't be deleted, so purchase
  // and stock history never lose their orders.
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items        PurchaseOrderItem[]
  transactions Transaction[]

  @@unique([companyId, poNumber])
  @@index([companyId])
  @@index([supplierId])
  @@index([branchId])
}

model PurchaseOrderItem {
  id       String @id @default(cuid())
  quantity Float
  unitCost Float

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

// ---------- Sales ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  // SO-0001, per company (lib/order-number.ts).
  orderNumber        String
  status             OrderStatus @default(PENDING)
  totalAmount        Float       @default(0)
  createdAt          DateTime    @default(now())
  // When goods left the business; the return window counts from here.
  fulfilledAt        DateTime?
  // The customer's own PO number, e.g. from an inbound EDI 850.
  customerPoNumber   String?
  // When the order confirmation was last emailed to the customer.
  confirmationSentAt DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("OrderBranch", fields: [branchId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items   OrderItem[]
  invoice Invoice?
  returns ReturnAuthorization[]
  // The accepted quote this order was made from, if any.
  quote   Quote?

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([branchId])
}

model OrderItem {
  id        String @id @default(cuid())
  quantity  Float
  unitPrice Float

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  returnItems ReturnItem[]

  @@index([orderId])
}

// ---------- Quotes ----------

// Draft -> Sent -> Accepted (becomes an order) or Declined. A sent quote past
// its valid until date shows as expired; that is worked out, not stored.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?
  notes       String?
  totalAmount Float       @default(0)
  sentAt      DateTime?
  // When it was accepted or declined.
  decidedAt   DateTime?

  // Online acceptance: the secret link sent to the customer, when they
  // first opened it, and who accepted (typed name) from where.
  publicToken    String?   @unique
  viewedAt       DateTime?
  // When the "expires soon" reminder was made, so it's made once.
  expiryNudgedAt DateTime?
  signedName     String?
  signedIp       String?
  declineReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // The pipeline deal this quote prices; accepting it wins the deal.
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation("QuoteBranch", fields: [branchId], references: [id], onDelete: SetNull)

  // Set once accepted: the order made from it.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  items QuoteItem[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
  @@index([customerId])
  @@index([dealId])
}

// A product on a deal, before any quote exists.
model DealItem {
  id        String @id @default(cuid())
  quantity  Float
  unitPrice Float

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([dealId])
}

model QuoteItem {
  id        String @id @default(cuid())
  quantity  Float
  // Starts at the product's price and can be changed, e.g. for a discount.
  unitPrice Float

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
}

// ---------- Returns (RMA) ----------

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

// Only resellable goods go back into stock when a return is received;
// damaged goods are refunded but written off.
enum ReturnCondition {
  RESELLABLE
  DAMAGED
}

model ReturnAuthorization {
  id                   String       @id @default(cuid())
  rmaNumber            String
  status               ReturnStatus @default(REQUESTED)
  reason               String
  notes                String?
  // Copied from the policy when the return is opened, so later policy
  // edits never change the refund on a return already in progress.
  restockingFeePercent Float        @default(0)
  refundAmount         Float        @default(0)
  createdAt            DateTime     @default(now())
  receivedAt           DateTime?
  refundedAt           DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  items ReturnItem[]

  @@unique([companyId, rmaNumber])
  @@index([companyId])
  @@index([orderId])
}

// Per company return rules, so a clothing store, an electronics reseller
// and a wholesaler can each run returns their own way. A company with no
// row uses the defaults in lib/returns-policy.ts.
model ReturnPolicy {
  id                   String  @id @default(cuid())
  enabled              Boolean @default(true)
  windowDays           Int     @default(30)
  requireApproval      Boolean @default(true)
  restockingFeePercent Float   @default(0)
  restockDamaged       Boolean @default(false)
  // One reason per line; shown as the reason choices on a new return.
  reasons              String

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model ReturnItem {
  id        String          @id @default(cuid())
  quantity  Float
  unitPrice Float
  condition ReturnCondition @default(RESELLABLE)

  returnId String
  rma      ReturnAuthorization @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([orderItemId])
}

// ---------- Invoicing ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  taxRate            Float         @default(0)
  totalAmount        Float         @default(0)
  createdAt          DateTime      @default(now())
  lastReminderSentAt DateTime?
  sentAt             DateTime?
  // Running totals of the payments and credit notes below, kept in step by
  // lib/invoice-payments.ts. Balance due = totalAmount - amountPaid - amountCredited.
  amountPaid         Float         @default(0)
  amountCredited     Float         @default(0)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("InvoiceBranch", fields: [branchId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  lineItems    InvoiceLineItem[]
  payments     InvoicePayment[]
  creditNotes  CreditNote[]
  transactions Transaction[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([branchId])
}

model InvoiceLineItem {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

// ---------- Accounting ----------

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Float
  description String?
  date        DateTime        @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  // The purchase order whose receipt booked this expense (lib/purchase-receipt.ts).
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Controlling: which cost center or internal order carries this cost.
  costCenterId    String?
  costCenter      CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  internalOrderId String?
  internalOrder   InternalOrder? @relation(fields: [internalOrderId], references: [id], onDelete: SetNull)

  // The branch this money belongs to, for profit per branch. Null means
  // company wide (head office costs and the like).
  branchId String?
  branch   Branch? @relation("TransactionBranch", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([costCenterId])
  @@index([internalOrderId])
  @@index([branchId])
  @@index([purchaseOrderId])
}

// ---------- HR & Payroll ----------

enum EmployeeStatus {
  ACTIVE
  TERMINATED
}

model Employee {
  id         String         @id @default(cuid())
  name       String
  email      String?
  position   String?
  department String?
  salary     Float          @default(0)
  hireDate   DateTime       @default(now())
  status     EmployeeStatus @default(ACTIVE)

  // Paid payroll for this employee counts as cost on this cost center.
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Which branch this belongs to. Existing rows were moved into each
  // company's Main branch; new rows always get one.
  branchId String?
  branch   Branch? @relation("EmployeeBranch", fields: [branchId], references: [id], onDelete: SetNull)

  payrollItems PayrollItem[]
  tasks        Task[]
  tickets      Ticket[]

  @@index([companyId])
  @@index([branchId])
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
}

model PayrollRun {
  id          String           @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(DRAFT)
  totalAmount Float            @default(0)
  processedAt DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items PayrollItem[]

  @@index([companyId])
}

model PayrollItem {
  id         String @id @default(cuid())
  grossPay   Float
  deductions Float  @default(0)
  netPay     Float

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([payrollRunId])
}

// ---------- Project Management ----------

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  tasks        Task[]
  transactions Transaction[]

  @@index([companyId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  comments TaskComment[]

  @@index([projectId])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ---------- Customer Support ----------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model Ticket {
  id          String         @id @default(cuid())
  subject     String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])

  messages TicketMessage[]

  @@index([companyId])
}

enum TicketMessageAuthor {
  STAFF
  CUSTOMER
}

model TicketMessage {
  id         String              @id @default(cuid())
  content    String
  authorType TicketMessageAuthor
  createdAt  DateTime            @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ---------- AI Assistant ----------

enum ChatRole {
  USER
  ASSISTANT
}

model AiChatMessage {
  id        String   @id @default(cuid())
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiActions AiAction[]

  @@index([companyId])
}

// ---------- AI Actions (proposals + audit log) ----------

enum AiActionType {
  CREATE_TASK
  UPDATE_TICKET_STATUS
  UPDATE_TICKET_PRIORITY
  UPDATE_CUSTOMER_STATUS
  CREATE_INVOICE
  SEND_OVERDUE_REMINDER
}

enum AiActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AiAction {
  id         String         @id @default(cuid())
  type       AiActionType
  status     AiActionStatus @default(PENDING)
  summary    String
  input      String
  result     String?
  error      String?
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?
  executedAt DateTime?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedByUserId String
  requestedBy       User   @relation("AiActionRequestedBy", fields: [requestedByUserId], references: [id])

  decidedByUserId String?
  decidedBy       User?   @relation("AiActionDecidedBy", fields: [decidedByUserId], references: [id])

  chatMessageId String?
  chatMessage   AiChatMessage? @relation(fields: [chatMessageId], references: [id])

  @@index([companyId])
  @@index([chatMessageId])
}

// ---------- Documents ----------

enum DocumentEntityType {
  CUSTOMER
  INVOICE
  TICKET
  PROJECT
  CAMPAIGN
  EMPLOYEE
}

model Document {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType DocumentEntityType
  entityId   String

  @@index([companyId, entityType, entityId])
}

// ---------- Automation ----------

enum ReportFrequency {
  OFF
  WEEKLY
  MONTHLY
  QUARTERLY
}

model AutomationSettings {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  overdueInvoiceReminders Boolean   @default(false)
  lowStockReorder         Boolean   @default(false)
  staleTicketEscalation   Boolean   @default(false)
  staleLeadCleanup        Boolean   @default(false)
  creditLimitWarnings     Boolean   @default(false)
  // Fulfilling a sales order creates its draft invoice (sent only by a person).
  draftInvoiceOnFulfil    Boolean   @default(false)
  // Daily email to owners and admins: purchase orders past their expected
  // date and confirmed sales orders not fulfilled after a week.
  lateOrderAlerts         Boolean   @default(false)
  lateOrderAlertSentAt    DateTime?
  // Daily email to owners and admins: lots with stock that are expiring
  // within the inventory warning window, or already expired.
  lotExpiryAlerts         Boolean   @default(false)
  lotExpiryAlertSentAt    DateTime?

  // A single outgoing webhook URL (Slack Incoming Webhook, Zapier "Catch
  // Hook", or any custom JSON endpoint). Fires on the five automation
  // events above (only when each is itself enabled) plus every new support
  // ticket.
  webhookUrl String?

  // Emails a PDF business report (KPIs + charts) to the company on the
  // chosen cadence. lastReportSentAt drives the due check the same way
  // Invoice.lastReminderSentAt does for overdue reminders.
  reportFrequency  ReportFrequency @default(OFF)
  lastReportSentAt DateTime?

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Integrations ----------

model GoogleIntegration {
  id           String    @id @default(cuid())
  email        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // Space separated Google scopes granted; reading mail needs gmail.readonly.
  scopes       String    @default("")
  // The mailbox sync has logged everything up to here.
  mailSyncedAt DateTime?

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- CRM extras ----------

model CustomerTag {
  id        String   @id @default(cuid())
  name      String
  // A colour id from lib/crm-tags.ts.
  color     String   @default("blue")
  createdAt DateTime @default(now())

  customers Customer[]

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

// A field the company adds to every customer, like "Industry".
model CustomField {
  id        String          @id @default(cuid())
  label     String
  type      CustomFieldType @default(TEXT)
  // The choices for a SELECT field.
  options   String[]
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// CRM settings per company: who sees which customers, the web lead form,
// and logging customer emails from the connected Gmail.
model CrmSettings {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  // Employees see only the customers they own (and their deals, quotes and
  // reminders). Owners and admins always see everything.
  ownCustomersOnly Boolean @default(false)

  // Log emails to and from customers found in the connected Gmail.
  emailLogging Boolean @default(false)

  // The public lead form at /f/<formToken>.
  formEnabled Boolean @default(false)
  formToken   String? @unique
  formTitle   String?
  formIntro   String?
  formThanks  String?
  // Who new leads go to; falls back to the company owner.
  formOwnerId String?

  // Dialling code added to local numbers ("082...") for WhatsApp links.
  whatsappCountryCode String @default("27")

  // Built in automatic steps (lib/crm-auto.ts), on unless switched off.
  autoQuoteOpened Boolean @default(true)
  autoQuoteExpiry Boolean @default(true)
  autoDealOverdue Boolean @default(true)
  dailyDigest     Boolean @default(true)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// A group of customers someone marked as "not duplicates", so the
// duplicates page stops suggesting it. `key` is the sorted ids joined.
model DuplicateDismissal {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

// A series of emails sent to a customer a few days apart, until they reply.
model EmailSequence {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       EmailSequenceStep[]
  enrollments SequenceEnrollment[]

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model EmailSequenceStep {
  id        String @id @default(cuid())
  position  Int
  // Days after the previous email (or after enrolling, for the first).
  delayDays Int    @default(0)
  subject   String
  body      String

  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REPLIED
  STOPPED
}

// One customer going through one sequence.
model SequenceEnrollment {
  id         String           @id @default(cuid())
  status     EnrollmentStatus @default(ACTIVE)
  // How many emails have gone out; the next one is steps[sent].
  sent       Int              @default(0)
  nextSendAt DateTime?
  lastSentAt DateTime?
  endedAt    DateTime?
  // Why it stopped, in plain words ("Unsubscribed", "Stopped by Ana").
  endReason  String?
  createdAt  DateTime         @default(now())

  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  enrolledById String?
  enrolledBy   User?   @relation("SequenceEnroller", fields: [enrolledById], references: [id], onDelete: SetNull)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, customerId])
  @@index([status, nextSendAt])
  @@index([customerId])
}

// ---------- Automation locking ----------

// Singleton row (a fixed id, e.g. "automations") used as a lease lock so
// only one process runs a given background job at a time, safe under
// Prisma's connection pooling (unlike a Postgres advisory lock, which is
// tied to a specific connection the pool doesn't guarantee stays fixed
// across an acquire/release pair).
model RunLock {
  id          String    @id
  lockedUntil DateTime?
}

// ---------- Marketing ----------

enum CampaignChannel {
  EMAIL
  SOCIAL
  ADS
  EVENT
  REFERRAL
  OTHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id        String          @id @default(cuid())
  name      String
  channel   CampaignChannel @default(OTHER)
  status    CampaignStatus  @default(DRAFT)
  budget    Float           @default(0)
  // What was actually spent so far (budget is the plan). Cost per lead and
  // return on spend use this; see lib/campaign-stats.ts.
  spent     Float           @default(0)
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime        @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  leads Customer[]

  @@index([companyId])
}

// ---------- Calendar ----------

enum CalendarEventType {
  MEETING
  REMINDER
  OTHER
}

model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        CalendarEventType @default(MEETING)
  startAt     DateTime
  endAt       DateTime?
  createdAt   DateTime          @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, startAt])
}

// ---------- Billing ----------

// One flat-rate subscription per company. Single plan for now (see
// price_1TrKojRxRmfasatIyltWTQit in Stripe) — a Plan model can be added
// later if multiple tiers are introduced.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  // "monthly" or "yearly", from the Stripe price's lookup key (lib/plans.ts).
  // Null for trials and the old single $49 price.
  billingInterval      String?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Platform settings ----------

// Singleton row (fixed id "platform") for app-wide config that isn't tied to
// any one tenant company — e.g. the email-sending credential shared by every
// company's transactional email. Only settable by the platform operator
// (gated by PLATFORM_ADMIN_EMAIL, not by any company's OWNER role), since a
// regular tenant should never be able to see or overwrite the credential
// every other tenant's email depends on.
model PlatformSettings {
  id              String   @id
  resendApiKey    String?
  resendFromEmail String?
  groqApiKey      String?
  openaiApiKey    String?
  updatedAt       DateTime @updatedAt
}

// ---------- Manufacturing & MRP ----------

// One line of a bill of materials: making one unit of `parent` uses
// `quantity` units of `component`. A product with BOM lines is made in
// house; one without is bought.
model BomLine {
  id       String @id @default(cuid())
  quantity Float

  parentId String
  parent   Product @relation("BomParent", fields: [parentId], references: [id], onDelete: Cascade)

  componentId String
  component   Product @relation("BomComponent", fields: [componentId], references: [id])

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([parentId, componentId])
  @@index([companyId])
  @@index([componentId])
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id          String          @id @default(cuid())
  woNumber    String
  status      WorkOrderStatus @default(PLANNED)
  quantity    Float
  notes       String?
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, woNumber])
  @@index([companyId])
  @@index([productId])
}

// Per company MRP rules. A company with no row uses the defaults in
// lib/mrp-settings-presets.ts.
model MrpSettings {
  id                   String  @id @default(cuid())
  enabled              Boolean @default(true)
  // Count PENDING sales orders as demand, not just CONFIRMED ones.
  includePendingOrders Boolean @default(false)
  // Treat each product's reorder level as safety stock to keep on hand.
  useSafetyStock       Boolean @default(true)
  // Allow a work order to complete even when components are short
  // (stock can go negative until the paperwork catches up).
  allowNegativeStock   Boolean @default(false)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- EDI (ANSI X12) ----------

// This company's own EDI identity and file format. A company with no row
// has EDI switched off until it's set up.
model EdiSettings {
  id                  String  @id @default(cuid())
  enabled             Boolean @default(true)
  isaQualifier        String  @default("ZZ")
  isaId               String
  gsId                String
  // "004010" or "005010".
  version             String  @default("004010")
  // T = test, P = production (ISA15).
  usageIndicator      String  @default("T")
  elementSeparator    String  @default("*")
  subElementSeparator String  @default(">")
  segmentTerminator   String  @default("~")
  nextControlNumber   Int     @default(1)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// A customer or supplier this company exchanges EDI files with.
model EdiPartner {
  id           String   @id @default(cuid())
  name         String
  isaQualifier String   @default("ZZ")
  isaId        String
  gsId         String
  enabled      Boolean  @default(true)
  // Which documents are exchanged with this partner.
  receive850   Boolean  @default(true)
  send810      Boolean  @default(true)
  send856      Boolean  @default(true)
  send850      Boolean  @default(true)
  // Inbound orders: take the partner's prices, or use our own list price.
  useEdiPrices Boolean  @default(true)
  createdAt    DateTime @default(now())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  documents EdiDocument[]

  @@unique([companyId, isaQualifier, isaId])
  @@index([companyId])
}

enum EdiDirection {
  INBOUND
  OUTBOUND
}

enum EdiStatus {
  GENERATED
  PROCESSED
  REJECTED
}

// Every X12 file generated or received, kept as sent so it can be
// downloaded again or audited.
model EdiDocument {
  id            String       @id @default(cuid())
  direction     EdiDirection
  docType       String
  status        EdiStatus
  controlNumber Int
  reference     String?
  error         String?
  content       String
  createdAt     DateTime     @default(now())

  partnerId String?
  partner   EdiPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // What the document is about, when it maps to a record here.
  orderId         String?
  purchaseOrderId String?
  invoiceId       String?
  // An inbound document's 997 acknowledgment, and vice versa.
  acknowledgesId  String?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([partnerId])
  @@index([orderId])
}

// ---------- Controlling (CO) ----------

model CostCenter {
  id          String   @id @default(cuid())
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Optional: ties this cost center to a branch, for profit per branch.
  branchId String?
  branch   Branch? @relation("CostCenterBranch", fields: [branchId], references: [id], onDelete: SetNull)

  transactions     Transaction[]
  employees        Employee[]
  budgets          CostBudget[]
  postings         CoPosting[]
  settlingOrders   InternalOrder[]        @relation("SettlementReceiver")
  allocationsSent  CoAllocation[]         @relation("AllocationSender")
  allocationShares CoAllocationReceiver[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
}

// Planned cost for one cost center in one calendar month.
model CostBudget {
  id     String @id @default(cuid())
  year   Int
  month  Int
  amount Float

  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([costCenterId, year, month])
}

enum InternalOrderStatus {
  OPEN
  CLOSED
  SETTLED
}

// A temporary cost collector (a trade fair, a campaign, a repair) with its
// own budget, settled onto a cost center when it's done.
model InternalOrder {
  id          String              @id @default(cuid())
  orderNumber String
  name        String
  description String?
  budget      Float               @default(0)
  status      InternalOrderStatus @default(OPEN)
  createdAt   DateTime            @default(now())
  closedAt    DateTime?
  settledAt   DateTime?

  settleToId String?
  settleTo   CostCenter? @relation("SettlementReceiver", fields: [settleToId], references: [id], onDelete: SetNull)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  postings     CoPosting[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
}

// A cost allocation cycle: shares one sender cost center's cost out to
// receivers by fixed percentages.
model CoAllocation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  senderId String
  sender   CostCenter @relation("AllocationSender", fields: [senderId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  receivers CoAllocationReceiver[]
  runs      CoAllocationRun[]

  @@index([companyId])
}

model CoAllocationReceiver {
  id      String @id @default(cuid())
  percent Float

  allocationId String
  allocation   CoAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  @@unique([allocationId, costCenterId])
}

model CoAllocationRun {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  amount    Float
  createdAt DateTime @default(now())

  allocationId String
  allocation   CoAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  postings CoPosting[]

  @@unique([allocationId, year, month])
}

enum CoPostingKind {
  ALLOCATION
  SETTLEMENT
}

// Secondary cost postings that exist only inside Controlling: they move
// cost between cost centers and orders without touching the books.
// Positive amounts add cost, negative amounts credit it away.
model CoPosting {
  id        String        @id @default(cuid())
  kind      CoPostingKind
  date      DateTime
  amount    Float
  reference String
  createdAt DateTime      @default(now())

  costCenterId    String?
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  internalOrderId String?
  internalOrder   InternalOrder?   @relation(fields: [internalOrderId], references: [id], onDelete: Cascade)
  runId           String?
  run             CoAllocationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([costCenterId])
  @@index([internalOrderId])
}

enum OverBudgetAction {
  NONE
  WARN
  BLOCK
}

// Per company Controlling rules. A company with no row uses the defaults
// in lib/controlling-presets.ts.
model ControllingSettings {
  id                   String           @id @default(cuid())
  enabled              Boolean          @default(true)
  // 1 = January. A July to June business would use 7.
  fiscalYearStartMonth Int              @default(1)
  overBudgetAction     OverBudgetAction @default(WARN)
  // How far over budget is still allowed before the action kicks in.
  tolerancePercent     Float            @default(0)
  includePayroll       Boolean          @default(true)
  requireCostCenter    Boolean          @default(false)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- Lot & serial tracking ----------

enum TrackingMode {
  NONE
  LOT
  SERIAL
}

enum UnitOfMeasure {
  EACH
  KG
  L
}

enum PickingRule {
  FIFO
  FEFO
}

// One lot (or, for serial products, one unit) of a product on hand.
model StockLot {
  id         String    @id @default(cuid())
  lotNumber  String
  quantity   Float
  expiresAt  DateTime?
  receivedAt DateTime  @default(now())
  // Where it came from: PO, WO, OPENING or RETURN.
  source     String

  purchaseOrderId String?
  workOrderId     String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // The branch the lot sits at. The same lot number can sit at two
  // branches once part of it is moved.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  movements LotMovement[]

  @@unique([productId, branchId, lotNumber])
  @@index([branchId])
  @@index([companyId])
  @@index([companyId, expiresAt])
}

enum LotMovementKind {
  RECEIPT
  SALE
  CONSUMPTION
  PRODUCTION
  RETURN
  OPENING
  TRANSFER_OUT
  TRANSFER_IN
}

// Every change to a lot's quantity, so any lot or serial can be traced
// forward to the customers who got it and back to where it came from.
model LotMovement {
  id        String          @id @default(cuid())
  kind      LotMovementKind
  // Positive adds to the lot, negative takes from it.
  quantity  Float
  createdAt DateTime        @default(now())

  lotId String
  lot   StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  orderId         String?
  purchaseOrderId String?
  workOrderId     String?
  returnId        String?
  transferId      String?

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([transferId])
  @@index([companyId])
  @@index([orderId])
}

// Per company picking and expiry rules. A company with no row uses the
// defaults in lib/inventory-settings.ts.
enum CostMethod {
  // Cost stays as typed on the product.
  MANUAL
  // Cost becomes the unit cost on the latest purchase order received.
  LAST_PRICE
  // Moving average of stock on hand and what was just received.
  AVERAGE
}

model InventorySettings {
  id                String      @id @default(cuid())
  pickingRule       PickingRule @default(FIFO)
  blockExpired      Boolean     @default(true)
  expiryWarningDays Int         @default(30)
  // How receiving a purchase order changes a product's cost.
  costMethod        CostMethod  @default(MANUAL)

  companyId  String  @unique
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ---------- CRM rules ----------

enum CrmRuleTrigger {
  DEAL_WON
  DEAL_LOST
  DEAL_STAGE
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  NEW_LEAD
  CUSTOMER_QUIET
}

enum CrmRuleAction {
  CREATE_REMINDER
  ADD_TAG
  ADD_TO_SEQUENCE
  SET_STATUS
  EMAIL_PERSON
}

// "When this happens, do that", run by lib/crm-rules.ts.
model CrmRule {
  id        String         @id @default(cuid())
  name      String
  active    Boolean        @default(true)
  trigger   CrmRuleTrigger
  // DEAL_STAGE: the stage entered. CUSTOMER_QUIET: days without contact.
  stage     DealStage?
  quietDays Int?

  action     CrmRuleAction
  // What the action needs, depending on its type: a reminder title and
  // days, a tag, a sequence, a status, a person and a message.
  title      String?
  dueInDays  Int?
  // A user id, or null for the customer's owner.
  assigneeId String?
  tagId      String?
  sequenceId String?
  status     CustomerStatus?
  message    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs CrmRuleRun[]

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, trigger])
}

// Each time a rule fired, so it fires once per thing ("deal:<id>") and the
// rules page can show when it last ran.
model CrmRuleRun {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  ruleId String
  rule   CrmRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, key])
}

// ---------- Stock history ----------

enum StockMovementKind {
  // The balance on hand when history started, or a new product's first stock.
  OPENING
  ADJUSTMENT
  RECEIPT
  SALE
  SALE_CANCELLED
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  PRODUCTION
  CONSUMPTION
  // A purchase order's receipt undone: the stock goes back out.
  RECEIPT_REVERSED
}

enum StockAdjustmentReason {
  COUNT
  DAMAGED
  LOST
  FOUND
  OTHER
}

// One change to a product's stock at one branch. Written by changeStock in
// lib/stock.ts, the only way stock changes, so every movement is here.
model StockMovement {
  id            String                 @id @default(cuid())
  kind          StockMovementKind
  // Positive adds stock, negative takes it.
  delta         Float
  // The branch's quantity right after this movement.
  quantityAfter Float
  reason        StockAdjustmentReason?
  note          String?
  createdAt     DateTime               @default(now())

  companyId  String
  companyRef Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Who made the change; empty for automatic ones (EDI, quotes accepted online).
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The record behind it, when there is one.
  orderId         String?
  purchaseOrderId String?
  transferId      String?
  returnId        String?
  workOrderId     String?

  @@index([productId, createdAt])
  @@index([branchId])
  @@index([companyId])
}

// ---------- Invoice payments and credit notes ----------

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

// Money received against an invoice; each one books its own income in
// Accounting (transactionId), dated when it was paid.
model InvoicePayment {
  id        String        @id @default(cuid())
  amount    Float
  paidAt    DateTime
  method    PaymentMethod @default(OTHER)
  reference String?
  createdAt DateTime      @default(now())

  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId     String
  userId        String?
  // The income transaction this payment booked.
  transactionId String? @unique

  @@index([invoiceId])
  @@index([companyId])
}

// Reduces what a customer owes on an invoice without money changing hands
// (a price correction, goodwill). Books nothing in Accounting.
model CreditNote {
  id           String   @id @default(cuid())
  creditNumber String
  amount       Float
  reason       String
  createdAt    DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId String
  userId    String?

  @@unique([companyId, creditNumber])
  @@index([invoiceId])
}

// ---------- Website contact form ----------

enum ContactTopic {
  SALES
  SUPPORT
  ENTERPRISE
  OTHER
}

// A message from the public /contact page, for the platform operator (not
// any company). Read in the platform admin area; handledAt marks it done.
model ContactMessage {
  id        String       @id @default(cuid())
  name      String
  email     String
  company   String?
  topic     ContactTopic @default(OTHER)
  message   String
  // Only asked for Enterprise questions, so a quote can start from numbers.
  teamSize  Int?
  branches  Int?
  createdAt DateTime     @default(now())
  handledAt DateTime?

  @@index([createdAt])
}
